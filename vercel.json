{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/compensation", "dest": "/compensation.html" },
    { "src": "/training", "dest": "/training.html" },
    { "src": "/technology", "dest": "/technology.html" },
    { "src": "/marketing", "dest": "/marketing.html" },
    { "src": "/culture", "dest": "/culture.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
